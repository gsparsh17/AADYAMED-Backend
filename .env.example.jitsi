# Video consultations (services/jitsi.service.js). Set ONE of the two blocks.
# Without either, rooms open on JITSI_BASE_URL (default meet.jit.si) with no
# token, and meet.jit.si asks the first person to sign in.

# Option A: Jitsi as a Service, jaas.8x8.vc -> API keys
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxx
JAAS_API_KEY_ID=xxxxxx
# Either the PEM text (newlines as \n) or a path to the downloaded .pk file
JAAS_PRIVATE_KEY_PATH=/home/ubuntu/keys/jaas.pk
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Option B: your own Jitsi server with JWT auth (prosody token plugin)
# JITSI_BASE_URL=https://meet.yourdomain.in
# JITSI_APP_ID=aadyaplus
# JITSI_APP_SECRET=long-random-secret

# Appointment times are read on this clock (minutes from UTC; 330 = IST)
CLINIC_TZ_OFFSET_MINUTES=330
